# Copy this file to .env.local and fill in the values.
# Keep all secrets server-side; never prefix them with NEXT_PUBLIC_.

FAL_KEY="your-fal-api-key"
NEON_CONNECTION_STRING="postgresql://user:password@host/database?sslmode=require"
VIRALLY_APP_URL="http://localhost:3000"
FAL_WEBHOOK_SECRET="your-fal-webhook-secret"

# Temporary opt-in only. Leave false in production until auth and a durable
# transactional credit ledger are connected.
VIRALLY_ALLOW_ANONYMOUS_GENERATION="false"

# --- Final-video MP4 export (Remotion Lambda) ---
# The in-app preview always plays the full edit. These enable server-side MP4
# export. Deploy the backend with `pnpm remotion:deploy`, then paste the values
# it prints. Without them, /api/.../render returns 501 (never a fake file).
REMOTION_AWS_REGION="us-east-1"
REMOTION_LAMBDA_FUNCTION_NAME=""
REMOTION_SERVE_URL=""
REMOTION_AWS_ACCESS_KEY_ID=""
REMOTION_AWS_SECRET_ACCESS_KEY=""

# Alternative to Lambda: a custom HTTP render worker that accepts { jobId, plan }
# and returns { outputUrl }. Used only if the Remotion Lambda vars are unset.
VIRALLY_RENDER_WORKER_URL=""
VIRALLY_RENDER_WORKER_TOKEN=""
