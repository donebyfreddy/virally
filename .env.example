# Copy this file to .env.local and fill in the values.
# Keep all secrets server-side; never prefix them with NEXT_PUBLIC_.

FAL_KEY="your-fal-api-key"
VIRALLY_APP_URL="http://localhost:3000"
FAL_WEBHOOK_SECRET="your-fal-webhook-secret"

# Temporary opt-in only. Leave false in production until auth and a durable
# transactional credit ledger are connected.
VIRALLY_ALLOW_ANONYMOUS_GENERATION="false"
